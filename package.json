{
  "name": "columnspaces",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "report": "tsx scripts/report.ts",
    "verify": "npm run export && npm run lint && npm run typecheck && npm run build && npm run test",
    "export": "tsx scripts/gen-manifest.ts && tsx scripts/export-lessons-md.ts",
    "manifest": "tsx scripts/gen-manifest.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "1.57.0",
    "plugin-inspect-react-code": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
